# ─────────────────────────────────────────────────────────────────────────────
# Darukaa.Earth — Environment Variable Reference
# Copy this file to .env (never commit .env)
# ─────────────────────────────────────────────────────────────────────────────

# ─── Frontend (prefix with VITE_ to expose to browser bundle) ────────────────
# Base URL of the FastAPI backend (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# Mapbox public token — obtain from https://account.mapbox.com
VITE_MAPBOX_TOKEN=

# ─── Backend ──────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string (PostGIS-enabled database required)
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/darukaa

# JWT — use a long, random, secret string in production
JWT_SECRET_KEY=CHANGE_ME_USE_A_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of allowed CORS origins (no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Database (used by docker-compose.yml) ───────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=darukaa
