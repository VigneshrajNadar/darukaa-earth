# Darukaa.Earth environment template — copy to .env and replace placeholders.
# Never commit a real .env file.

# Frontend (Vite only exposes variables prefixed with VITE_ to the browser)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_MAPBOX_TOKEN=your_mapbox_public_token

# Backend / PostGIS
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/darukaa
TEST_DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/darukaa_test

# Authentication
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEMO_USER_PASSWORD=replace-with-a-unique-demo-password

# Browser access
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Docker Compose database values
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=darukaa
